# /opt/leaderprism/.env on the Hostinger VPS — read by docker-compose.yml next to
# this file. Mode 600, owned by bizosadmin. Never commit real values.

# Fixed when the postgres volume is first initialized — changing it later also
# needs ALTER USER leaderprism PASSWORD '...' (see DEPLOYMENT-HOSTINGER.md).
POSTGRES_PASSWORD=                # openssl rand -hex 24

# Rotating either logs everyone out.
JWT_ACCESS_SECRET=                # openssl rand -hex 64
JWT_REFRESH_SECRET=               # openssl rand -hex 64

# Email. Empty connection string = log-only: NotificationsService writes an
# [EMAIL] line (including temporary passwords and links) to the API log instead
# of sending. Set both to an Azure Communication Services connection string and
# a verified sender address to send for real.
AZURE_COMMUNICATION_CONNECTION_STRING=
EMAIL_FROM=
EMAIL_FROM_NAME=LeaderPrism

# Web AI assistant. deploy-dev.yml overwrites this from the OPENAI_API_KEY GitHub
# secret on every deploy when that secret is set.
OPENAI_API_KEY=
